# Copia este archivo como .env y ajusta los valores.

# Puerto de la API en desarrollo (en producción se usa PORT si el servidor lo define)
API_PORT=4590
# URL pública desde la que se abre la plataforma (necesaria para biometría y enlaces en correos)
APP_ORIGIN=http://localhost:5190

# Exigir verificación biométrica del dispositivo para registrar acceso (true por defecto)
REQUIRE_BIOMETRIC=true
# Validar que la persona esté dentro de la geocerca del acceso (true por defecto)
ENFORCE_GEOFENCE=true

# Administrador inicial (solo se crea si no existe ningún operador)
SEED_ADMIN_EMAIL=correo.institucional@udg.mx
SEED_ADMIN_PASSWORD=cambia-esta-contraseña
SEED_ADMIN_NAME=Nombre del administrador

# Correo saliente (opcional). Sin SMTP, los correos se guardan en server/data/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UniAccess CUTlaquepaque <no-reply@udg.mx>
